# =========================================================================
# Hostinger VPS Container Configuration Parameters
# =========================================================================

# The URL where the Next.js backend communicates with the Ollama service
OLLAMA_BASE_URL=http://xxxxxxxxx:32772

# The default model that Next.js will auto-load in the interface.
DEFAULT_MODEL=qwen2.5:1.5b

# =========================================================================
# Traefik Reverse Proxy Configuration
# =========================================================================

# Domain name for routing
DOMAIN_NAME=chat.yourdomain.com

# External Traefik network name on the host
TRAEFIK_NETWORK=traefik_public

# Traefik Entrypoint (usually websecure for HTTPS)
TRAEFIK_ENTRYPOINT=websecure

# Traefik CertResolver configured in traefik.yml (e.g. myresolver or letsencrypt)
TRAEFIK_CERTRESOLVER=myresolver
